PORT=5001
NODE_ENV=development

# MySQL Database Configuration (Local or GCP Cloud SQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_resume_screener

# Google Gemini API Key
# (Get free from https://aistudio.google.com/app/apikey or GCP Console)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Frontend CORS Origin
CLIENT_URL=http://localhost:3000
